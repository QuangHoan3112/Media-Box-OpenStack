# MediaBox Neutron configuration
# Example values from the lab; adjust for a new cloud.
# The provider network must already be configured.

PUBLIC_NETWORK=public
PUBLIC_SUBNET=public-subnet
PUBLIC_CIDR=192.168.57.0/24
PROVIDER_PHYSICAL_NETWORK=physnet1

PRIVATE_NETWORK=private
PRIVATE_SUBNET=private-subnet
PRIVATE_CIDR=10.20.0.0/24
PRIVATE_NETWORK_TYPE=vxlan

ROUTER_NAME=mediabox-router
APP_SECURITY_GROUP=mediabox-app-sg
DB_SECURITY_GROUP=mediabox-db-sg

# Verify before deploying on another OpenStack cloud:
# - Public subnet gateway and allocation pool
# - Private subnet gateway and DHCP settings
# - Security Group Rules
# - Provider network bridge mapping
