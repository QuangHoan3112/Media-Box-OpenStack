# MediaBox storage configuration
# Based on the verified OpenStack lab.

SWIFT_CONTAINER=mediabox-media

DB_VOLUME_NAME=mediabox-db-data
DB_VOLUME_SIZE_GB=5
DB_INSTANCE_NAME=mediabox-db

